# Copia este archivo como .env.local y completa los valores. Nunca subas .env.local al repositorio.
ANTHROPIC_API_KEY=
# Modelo de Claude (por defecto claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-sonnet-5-5
# Tope de iteraciones herramienta → modelo por turno (por defecto 25)
MAX_ITERACIONES=25
# Tope de tokens (entrada + salida) por sesión (por defecto 300000)
MAX_TOKENS_SESION=300000
# Tiempo máximo de espera al proveedor por llamada, en milisegundos (por defecto 60000)
LLM_TIMEOUT_MS=60000
# Carpeta de salida (por defecto ./out; en Vercel se usa /tmp/out)
OUT_DIR=
